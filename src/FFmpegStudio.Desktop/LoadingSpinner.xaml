<UserControl x:Class="FFmpegStudio.Desktop.LoadingSpinner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsHitTestVisible="False" Focusable="False">
 <UserControl.Style><Style TargetType="UserControl"><Style.Triggers><Trigger Property="IsVisible" Value="True">
  <Trigger.EnterActions><BeginStoryboard Name="Spin"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.85" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
  <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="Spin"/></Trigger.ExitActions>
 </Trigger></Style.Triggers></Style></UserControl.Style>
 <UserControl.RenderTransform><RotateTransform CenterX="22" CenterY="22"/></UserControl.RenderTransform>
 <Viewbox Stretch="Uniform"><Grid Width="44" Height="44">
  <Ellipse Width="34" Height="34" Stroke="White" Opacity="0.25" StrokeThickness="3"/>
  <Path Data="M 22,5 A 17,17 0 0 1 39,22" Stroke="{DynamicResource Accent}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
 </Grid></Viewbox>
</UserControl>
