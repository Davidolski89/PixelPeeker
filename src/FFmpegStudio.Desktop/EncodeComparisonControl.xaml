<UserControl x:Class="FFmpegStudio.Desktop.EncodeComparisonControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FFmpegStudio.Desktop">
 <UserControl.Resources>
  <DataTemplate x:Key="ComparisonChoiceTemplate"><TextBlock Text="{Binding Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate>
  <DataTemplate x:Key="ComparisonTextTemplate"><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding CompareTwoEncodes}" Value="False"><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><DockPanel><Button local:ButtonHints.Key="ComparisonOpenA" Content="{DynamicResource Loc.EEE56A7D70147F1B}" Command="{Binding OpenACommand}" DockPanel.Dock="Right" Padding="8,4"/><TextBlock Text="{DynamicResource Loc.50BC4BFB07CEFAEA}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></DockPanel><ComboBox x:Name="EncodeASelector" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedA}" ItemTemplate="{StaticResource ComparisonChoiceTemplate}" local:ButtonHints.UsePreferences="True" ToolTip="{Binding SelectedA.Path}"/>
    <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Loc.9B6E20BDEE389442}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,5,0"/><TextBox x:Name="ComparisonOffsetA" Text="{Binding OffsetA,UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanOffsetA}" Width="72" local:ButtonHints.UsePreferences="True" ToolTip="{DynamicResource Loc.F4D4F2A2DA2C7F21}"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="2" Visibility="{Binding CompareTwoEncodes,Converter={StaticResource BoolVisibility}}"><DockPanel><Button local:ButtonHints.Key="ComparisonOpenB" Content="{DynamicResource Loc.C5A83B34D3463245}" Command="{Binding OpenBCommand}" DockPanel.Dock="Right" Padding="8,4"/><TextBlock Text="{DynamicResource Loc.EB227F641DA8D17B}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></DockPanel><ComboBox x:Name="EncodeBSelector" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedB}" ItemTemplate="{StaticResource ComparisonChoiceTemplate}" local:ButtonHints.UsePreferences="True" ToolTip="{Binding SelectedB.Path}"/>
    <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Loc.9B6E20BDEE389442}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,5,0"/><TextBox x:Name="ComparisonOffsetB" Text="{Binding OffsetB,UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanOffsetB}" Width="72" local:ButtonHints.UsePreferences="True" ToolTip="{DynamicResource Loc.F4D4F2A2DA2C7F21}"/></StackPanel>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="1"><WrapPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><TextBlock x:Name="ComparisonModeLabel" Text="{DynamicResource Loc.3C1354760387F90A}" Margin="0,0,8,5"/><ComboBox x:Name="ComparisonModeSelector" Width="300" ItemsSource="{Binding ModeChoices}" ItemTemplate="{StaticResource ComparisonChoiceTemplate}" SelectedValuePath="Value" SelectedValue="{Binding Mode,Mode=TwoWay,Converter={StaticResource SelectionValue}}" local:ButtonHints.UsePreferences="True" ToolTip="{DynamicResource Loc.F8D89E7B24EEB037}"/></StackPanel>
   <CheckBox x:Name="MatchReferenceToggle" Content="{DynamicResource Loc.FF4DFAC5BB2DA78B}" IsChecked="{Binding MatchReference}" IsEnabled="{Binding CanMatchReference}" Visibility="{Binding OriginalVisible,Converter={StaticResource BoolVisibility}}" Margin="0,0,12,0" local:ButtonHints.UsePreferences="True" ToolTip="{DynamicResource Loc.31F267BABB20C5AA}"/>
   <Button local:ButtonHints.Key="ComparisonOpenOriginal" Visibility="{Binding OriginalVisible,Converter={StaticResource BoolVisibility}}" Content="{DynamicResource Loc.84A530C90F168D0D}" Command="{Binding OpenOriginalCommand}" Padding="8,4"/>
   <TextBlock Text="{Binding OriginalLabel}" Visibility="{Binding OriginalVisible,Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Muted}" FontSize="10" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
  </WrapPanel>
  <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <WrapPanel Grid.ColumnSpan="2" Margin="0,0,0,2" local:ButtonHints.UsePreferences="True" ToolTip="{DynamicResource Loc.8345CF60A1ECF747}">
    <TextBlock Text="━" Foreground="{DynamicResource Accent}" Margin="0,0,4,0"/><TextBlock x:Name="CoverageLegend" Text="{DynamicResource Loc.F32F2AF8D455C01B}" FontSize="10" Margin="0,0,14,0"/>
    <TextBlock Text="▨" Foreground="{DynamicResource Warning}" Margin="0,0,4,0"/><TextBlock Text="{DynamicResource Loc.EC13A03EE30C6F33}" FontSize="10" Margin="0,0,14,0"/>
    <TextBlock Text="···" Foreground="{DynamicResource Muted}" Margin="0,0,4,0"/><TextBlock Text="{DynamicResource Loc.9927EA8FABF095F2}" FontSize="10"/>
   </WrapPanel>
   <TextBlock Grid.Row="1" Text="A" FontSize="10" FontWeight="SemiBold" Margin="0"/>
   <local:ComparisonAvailabilityStrip x:Name="AvailabilityA" Grid.Row="1" Grid.Column="1" Height="12" Margin="8,1,8,3" Intervals="{Binding CoverageA}" Duration="{Binding Maximum}" Position="{Binding Position}" Foreground="{DynamicResource Accent}" BorderBrush="{DynamicResource Warning}" Background="{DynamicResource Raised}"/>
   <TextBlock Grid.Row="2" Text="B" FontSize="10" FontWeight="SemiBold" Margin="0" Visibility="{Binding CompareTwoEncodes,Converter={StaticResource BoolVisibility}}"/>
   <local:ComparisonAvailabilityStrip x:Name="AvailabilityB" Grid.Row="2" Grid.Column="1" Height="12" Margin="8,1,8,3" Intervals="{Binding CoverageB}" Duration="{Binding Maximum}" Position="{Binding Position}" Foreground="{DynamicResource Accent}" BorderBrush="{DynamicResource Warning}" Background="{DynamicResource Raised}" Visibility="{Binding CompareTwoEncodes,Converter={StaticResource BoolVisibility}}"/>
   <Slider x:Name="ComparisonTimeline" Grid.Row="3" Grid.Column="1" Style="{StaticResource QualitySliderStyle}" Height="20" Margin="0" Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Position,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True" PreviewKeyDown="Timeline_KeyDown"/>
  </Grid>
  <WrapPanel Margin="0,3,0,4"><TextBlock Text="{DynamicResource Loc.ABB8595876D22722}" Margin="0,0,5,0"/><TextBox x:Name="ComparisonPosition" Text="{Binding Position,UpdateSourceTrigger=LostFocus,StringFormat=F3}" Width="76" Margin="0,0,6,3"/>
   <Button local:ButtonHints.Key="ComparisonPrevious" Content="←" Command="{Binding PreviousCommand}" Padding="9,4"/><Button local:ButtonHints.Key="ComparisonNext" Content="→" Command="{Binding NextCommand}" Padding="9,4"/>
   <Button local:ButtonHints.Key="ComparisonLoad" Content="{DynamicResource Loc.C585BDFA8A72CBED}" Command="{Binding LoadFramesCommand}" Padding="8,4"/>
   <CheckBox Content="{DynamicResource Loc.F3148D80A0D1CBFD}" IsChecked="{Binding SideBySide}" Margin="2,0,8,0"/>
   <Button local:ButtonHints.Key="ComparisonToggle" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Padding="8,4"/>
   <ComboBox x:Name="ComparisonZoom" Width="99" ItemsSource="{Binding ZoomChoices}" ItemTemplate="{StaticResource ComparisonChoiceTemplate}" SelectedValuePath="Value" SelectedValue="{Binding Zoom,Mode=TwoWay,Converter={StaticResource SelectionValue}}" local:ButtonHints.UsePreferences="True" ToolTip="{DynamicResource Loc.8BD9846747125EAE}"/>
  </WrapPanel></StackPanel>
  <Grid Grid.Row="2" MinHeight="100">
   <UniformGrid Columns="{Binding PanelCount}" Visibility="{Binding SideBySide,Converter={StaticResource BoolVisibility}}">
    <Grid Visibility="{Binding OriginalVisible,Converter={StaticResource BoolVisibility}}" Margin="0,0,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding ReferenceLabel}" TextWrapping="NoWrap" local:ButtonHints.UsePreferences="True" ToolTip="{Binding ReferenceLabel}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" Height="34" Margin="0,0,0,4"/><local:ComparisonImagePane x:Name="OriginalPane" Grid.Row="1" EmptyMessage="{Binding OriginalMessage}" Source="{Binding OriginalImage}" Zoom="{Binding Zoom}"/><TextBlock Grid.Row="2" Text="{Binding OriginalMessage}" FontSize="10" Height="42" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" local:ButtonHints.UsePreferences="True" ToolTip="{Binding OriginalMessage}"/></Grid>
    <Grid Margin="0,0,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding SelectedA.Label,StringFormat=A · {0}}" TextWrapping="NoWrap" local:ButtonHints.UsePreferences="True" ToolTip="{Binding SelectedA.Label,StringFormat=A · {0}}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" Height="34" Margin="0,0,0,4"/><local:ComparisonImagePane x:Name="PaneA" Grid.Row="1" EmptyMessage="{Binding MessageA}" Source="{Binding ImageA}" Zoom="{Binding Zoom}"/><TextBlock Grid.Row="2" Text="{Binding MessageA}" FontSize="10" Height="42" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" local:ButtonHints.UsePreferences="True" ToolTip="{Binding MessageA}"/></Grid>
    <Grid Visibility="{Binding CompareTwoEncodes,Converter={StaticResource BoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding SelectedB.Label,StringFormat=B · {0}}" TextWrapping="NoWrap" local:ButtonHints.UsePreferences="True" ToolTip="{Binding SelectedB.Label,StringFormat=B · {0}}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" Height="34" Margin="0,0,0,4"/><local:ComparisonImagePane x:Name="PaneB" Grid.Row="1" EmptyMessage="{Binding MessageB}" Source="{Binding ImageB}" Zoom="{Binding Zoom}"/><TextBlock Grid.Row="2" Text="{Binding MessageB}" FontSize="10" Height="42" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" local:ButtonHints.UsePreferences="True" ToolTip="{Binding MessageB}"/></Grid>
   </UniformGrid>
   <Grid Visibility="{Binding SingleVisible,Converter={StaticResource BoolVisibility}}">
    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/><RowDefinition Height="47"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding FocusLabel}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,12,4" local:ButtonHints.UsePreferences="True" ToolTip="{Binding FocusLabel}"/>
     <ComboBox x:Name="ComparisonFocus" Grid.Column="1" SelectedIndex="{Binding FocusIndex}" Width="240" Height="32" Margin="0,0,0,4" VerticalAlignment="Top" local:ButtonHints.UsePreferences="True" ToolTip="{Binding FocusLabel}">
      <ComboBoxItem Content="{DynamicResource Loc.50BC4BFB07CEFAEA}" ContentTemplate="{StaticResource ComparisonTextTemplate}"/>
      <ComboBoxItem Content="{DynamicResource Loc.EB227F641DA8D17B}" ContentTemplate="{StaticResource ComparisonTextTemplate}" IsEnabled="{Binding CompareTwoEncodes}"/>
      <ComboBoxItem Content="{Binding ReferenceLabel}" ContentTemplate="{StaticResource ComparisonTextTemplate}" IsEnabled="{Binding OriginalVisible}" local:ButtonHints.UsePreferences="True" ToolTip="{Binding ReferenceLabel}"/>
     </ComboBox>
    </Grid>
    <local:ComparisonImagePane x:Name="FocusPane" Grid.Row="1" EmptyMessage="{Binding FocusMessage}" Source="{Binding FocusImage}" Zoom="{Binding Zoom}"/>
    <TextBlock Grid.Row="2" Text="{Binding FocusMessage}" FontSize="11" Height="42" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" local:ButtonHints.UsePreferences="True" ToolTip="{Binding FocusMessage}"/>
   </Grid>
   <Grid Background="#99080B10" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"><local:LoadingSpinner Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,7,0,0">
   <WrapPanel><Button x:Name="GenerateComparisonSamples" local:ButtonHints.Key="GenerateFrames" Content="{DynamicResource Loc.9E7FF6DBF3220887}" Command="{Binding GenerateSamplesCommand}" Padding="8,4"/><TextBlock Text="{DynamicResource Loc.33473E485DEA8FC1}" Visibility="{Binding OriginalVisible,Converter={StaticResource BoolVisibility}}" FontSize="11" Foreground="{DynamicResource Muted}"/></WrapPanel>
   <ListBox x:Name="ComparisonSamples" ItemsSource="{Binding Samples}" SelectedItem="{Binding SelectedSample}" Height="100" Margin="0,4,0,6" Visibility="{Binding HasSamples,Converter={StaticResource BoolVisibility}}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,0"><Image Source="{Binding Thumbnail}" Width="110" Height="62" Stretch="Uniform"/><TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox><TextBlock x:Name="ComparisonStatus" Text="{Binding Status}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" local:ButtonHints.UsePreferences="True" ToolTip="{Binding Status}" Foreground="{DynamicResource Accent}" FontSize="11"/><TextBlock Text="{Binding ReferenceDescription}" Visibility="{Binding OriginalVisible,Converter={StaticResource BoolVisibility}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" local:ButtonHints.UsePreferences="True" ToolTip="{Binding ReferenceDescription}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
 </Grid>
</UserControl>
