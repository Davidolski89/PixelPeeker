<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>PixelPeeker.Avalonia</AssemblyName>
    <RootNamespace>FFmpegStudio.Avalonia</RootNamespace>
    <Title>PixelPeeker</Title>
    <Description>Avalonia shell for PixelPeeker. Phase 1 shows the library, media info and queue.</Description>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="../FFmpegStudio.Desktop/Assets/PixelPeeker.png" Link="Assets/PixelPeeker.png" />
    <ProjectReference Include="../FFmpegStudio.Shared/FFmpegStudio.Shared.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
