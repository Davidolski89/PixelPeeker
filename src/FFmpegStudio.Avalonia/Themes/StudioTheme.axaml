<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window.studio">
        <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="Window.studio TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Window.studio TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Margin" Value="0,10,0,5"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Window.studio TextBlock.section">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,6,0,12"/>
    </Style>
    <Style Selector="Window.studio TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Window.studio TextBlock.accent">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Window.studio Button">
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Margin" Value="0,0,6,4"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Window.studio Button:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Window.studio Button:pressed">
        <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <Style Selector="Window.studio Button:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Window.studio Button.primary">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Window.studio Button.primary:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Window.studio TextBox">
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="Padding" Value="7,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionText}"/>
    </Style>
    <Style Selector="Window.studio TextBox:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Window.studio TextBox.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Window.studio ComboBox">
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MaxDropDownHeight" Value="360"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3"/>
                    <Grid ColumnDefinitions="*,28">
                        <ContentControl x:Name="ContentPresenter"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        Margin="8,5,4,5"
                                        VerticalContentAlignment="Center"
                                        HorizontalContentAlignment="Stretch"
                                        IsHitTestVisible="False"
                                        IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}"/>
                        <TextBox Name="PART_EditableTextBox"
                                 Grid.Column="0"
                                 Margin="2,1,0,0"
                                 Padding="6,4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 Text="{TemplateBinding Text, Mode=TwoWay}"
                                 IsVisible="{TemplateBinding IsEditable}"/>
                        <TextBlock Grid.Column="1" Text="⌄" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Popup Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding $parent[ComboBox]}"
                           Placement="Bottom"
                           IsLightDismissEnabled="True"
                           WindowManagerAddShadowHint="False">
                        <Border Background="{DynamicResource Raised}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <ScrollViewer>
                                <ItemsPresenter Name="PART_ItemsPresenter"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Window.studio ComboBox:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Window.studio ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style Selector="Window.studio ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Selection}"/>
        <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
    </Style>
    <Style Selector="Window.studio ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Selection}"/>
        <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
    </Style>
    <Style Selector="Window.studio CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Margin" Value="0,6"/>
    </Style>
    <Style Selector="Window.studio Expander">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Margin" Value="0,6,0,8"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <Style Selector="Window.studio TabControl">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="Window.studio TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Window.studio TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Window.studio TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="Window.studio ListBox">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Window.studio ListBoxItem">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Window.studio ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>
    <Style Selector="Window.studio ListBoxItem:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Window.studio DataGrid">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="42"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
    </Style>
    <Style Selector="Window.studio DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Window.studio DataGridCell">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style Selector="Window.studio DataGridCell:selected">
        <Setter Property="Background" Value="{DynamicResource Selection}"/>
        <Setter Property="Foreground" Value="{DynamicResource SelectionText}"/>
    </Style>
    <Style Selector="Window.studio ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="5"/>
    </Style>
    <Style Selector="Window.studio Slider">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Border}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent" Height="28">
                    <Border Height="4" Margin="7,0" Background="{DynamicResource Border}" CornerRadius="2" VerticalAlignment="Center"/>
                    <Track Name="PART_Track"
                           Margin="7,0"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           Orientation="{TemplateBinding Orientation}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                        <Track.DecreaseButton>
                            <RepeatButton Focusable="False" Background="Transparent">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Height="4" Background="{DynamicResource Accent}" CornerRadius="2" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Focusable="False" Background="Transparent">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseButton>
                        <Thumb Width="16" Height="16" Background="Transparent" BorderThickness="0">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Ellipse Fill="{DynamicResource Accent}" Stroke="{DynamicResource Bg}" StrokeThickness="2"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Window.studio Slider:focus-within /template/ Thumb">
        <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif"/>
        <Setter Property="Background" Value="{DynamicResource Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="MaxWidth" Value="430"/>
    </Style>
</Styles>
